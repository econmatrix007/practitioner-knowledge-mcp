<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for the always-on knowledge MCP server (Streamable HTTP).
  Do not edit paths by hand: deploy/macos/install_launchd.sh fills every
  __PLACEHOLDER__ and installs the result in ~/Library/LaunchAgents/.
  Environment entries left empty are removed by the installer.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/knowledge-mcp</string>
    <string>--transport</string>
    <string>http</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>KNOWLEDGE_MCP_DB</key>
    <string>__DB__</string>
    <key>KNOWLEDGE_MCP_HOST</key>
    <string>__HOST__</string>
    <key>KNOWLEDGE_MCP_PORT</key>
    <string>__PORT__</string>
    <key>KNOWLEDGE_MCP_TOKEN_FILE</key>
    <string>__TOKEN_FILE__</string>
    <key>KNOWLEDGE_MCP_ALLOWED_HOSTS</key>
    <string>__ALLOWED_HOSTS__</string>
    <key>KNOWLEDGE_MCP_PLUGINS</key>
    <string>__PLUGINS__</string>
  </dict>

  <!-- Start at login and restart whenever the process exits. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Wait 10 seconds between restarts, e.g. while Tailscale comes up at boot. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/server.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/server.err.log</string>
</dict>
</plist>
